# SEC EDGAR API (https://sec-api.io)
SEC_API_KEY=your_sec_api_key_here

# Alpha Vantage (https://www.alphavantage.co/support/#api-key)
ALPHA_VANTAGE_KEY=your_alpha_vantage_key_here

# FRED — Federal Reserve Economic Data (https://fred.stlouisfed.org/docs/api/api_key.html)
FRED_API_KEY=your_fred_api_key_here

# Groq — free tier at console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Financial Modeling Prep (https://site.financialmodelingprep.com/developer/docs)
FMP_API_KEY=your_fmp_api_key_here

# Reddit — create a free "script" app at https://www.reddit.com/prefs/apps
# Required for altdata reddit (anonymous API calls are now blocked)
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
